{
 "format": "fsm-tool/1",
 "name": "Coffee machine (event parameters)",
 "vars": "credit := 0, price := 150",
 "initAngle": 3.141592653589793,
 "states": [
  {
   "id": "s1",
   "label": "Idle",
   "x": 180,
   "y": 250,
   "accepting": false
  },
  {
   "id": "s2",
   "label": "Paying",
   "x": 470,
   "y": 250,
   "accepting": false
  },
  {
   "id": "s3",
   "label": "Brewing",
   "x": 760,
   "y": 250,
   "accepting": false
  }
 ],
 "transitions": [
  {
   "id": "t1",
   "from": "s1",
   "to": "s2",
   "event": "coin(v)",
   "guard": "v > 0",
   "action": "credit += v",
   "bend": 0,
   "loopAngle": -1.5707963267948966
  },
  {
   "id": "t2",
   "from": "s2",
   "to": "s2",
   "event": "coin(v)",
   "guard": "credit + v <= 1000",
   "action": "credit += v",
   "bend": 0,
   "loopAngle": -1.5707963267948966
  },
  {
   "id": "t3",
   "from": "s2",
   "to": "s3",
   "event": "button",
   "guard": "credit >= price",
   "action": "credit -= price",
   "bend": 35,
   "loopAngle": -1.5707963267948966
  },
  {
   "id": "t4",
   "from": "s2",
   "to": "s2",
   "event": "button",
   "guard": "credit < price",
   "action": "",
   "bend": 0,
   "loopAngle": 1.5707963267948966
  },
  {
   "id": "t5",
   "from": "s2",
   "to": "s1",
   "event": "refund",
   "guard": "",
   "action": "credit := 0",
   "bend": 35,
   "loopAngle": -1.5707963267948966
  },
  {
   "id": "t6",
   "from": "s3",
   "to": "s2",
   "event": "done",
   "guard": "credit > 0",
   "action": "",
   "bend": 35,
   "loopAngle": -1.5707963267948966
  },
  {
   "id": "t7",
   "from": "s3",
   "to": "s1",
   "event": "done",
   "guard": "credit = 0",
   "action": "",
   "bend": -120,
   "loopAngle": -1.5707963267948966
  }
 ],
 "initial": "s1",
 "input": "coin(50) coin(100) button done coin(200) refund"
}
